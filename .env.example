# Copy to .env to override. Docker Compose works without one: every value
# below is also the default inside compose.yaml. .env is never committed.

# dev | test | prod. In prod the API and worker refuse to start if DEMO_MODE
# is on or any FAULT_* variable is non-zero.
ENV=dev

# Postgres container credentials (dev only; never published outside compose).
POSTGRES_USER=baton
POSTGRES_PASSWORD=baton
POSTGRES_DB=baton

# App database. The async driver is required: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://baton:baton@db:5432/baton

# Database used by pytest. Tests FAIL (never skip) when this is missing.
# Set automatically inside compose.test.yaml; set it yourself to run pytest on the host.
TEST_DATABASE_URL=postgresql+asyncpg://baton:baton@localhost:5433/baton_test

# Shows the quick account switcher and the demo password on the login page.
DEMO_MODE=true

# Idle session lifetime in hours (SPEC 5.4).
SESSION_TTL_HOURS=12

# Dev-only fault injection: probability (0-1) that the notify handler fails,
# to demonstrate retries and dead letters. Must be 0 in prod.
FAULT_NOTIFY_FAIL_RATE=0

# debug | info | warning | error
LOG_LEVEL=info
